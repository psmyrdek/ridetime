---
import { Image } from 'astro:assets';
import logoWhite from '../assets/images/logo-white.png';
import SocialLinks from './SocialLinks.astro';

const nav = [
  { label: 'Najnowszy', href: '#najnowszy' },
  { label: 'Strava', href: '#strava' },
  { label: 'Shorts', href: '#shorts' },
  { label: 'Filmy', href: '#filmy' },
];
---

<header class="sticky top-0 z-30 border-b border-white/5 bg-ridetime-dark/80 backdrop-blur-lg">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="shrink-0">
      <Image src={logoWhite} alt="ridetime" class="h-9 w-auto" loading="eager" />
    </a>
    <nav class="hidden md:block" aria-label="Sekcje">
      <ul class="flex gap-1 text-sm font-medium">
        {nav.map(({ label, href }) => (
          <li>
            <a href={href} class="rounded-full px-4 py-2 text-slate-300 transition hover:bg-white/5 hover:text-white">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <SocialLinks class="-mr-2" />
  </div>
</header>
