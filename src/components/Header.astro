---
import { Image } from 'astro:assets';
import logoWhite from '../assets/images/logo-white.png';
import SocialLinks from './SocialLinks.astro';

const nav = [
  { label: 'Najnowszy', href: '/#najnowszy' },
  { label: 'Strava', href: '/#strava' },
  { label: 'Shorts', href: '/#shorts' },
  { label: 'Filmy', href: '/#filmy' },
  { label: 'Podjazdy', href: '/podjazdy' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-30 border-b border-white/5 bg-ridetime-dark/80 backdrop-blur-lg" data-header>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="shrink-0">
      <Image src={logoWhite} alt="ridetime" class="h-9 w-auto" loading="eager" />
    </a>
    <nav class="hidden md:block" aria-label="Sekcje">
      <ul class="flex gap-1 text-sm font-medium">
        {nav.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={href === currentPath ? 'page' : undefined}
              class:list={[
                'rounded-full px-4 py-2 transition hover:bg-white/5 hover:text-white',
                href === currentPath ? 'bg-white/5 text-white' : 'text-slate-300',
              ]}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="hidden md:block">
      <SocialLinks class="-mr-2" />
    </div>
    <button
      type="button"
      class="group -mr-2 grid size-10 place-items-center rounded-full text-slate-200 transition hover:bg-white/10 md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-toggle>
      <span class="sr-only">Menu</span>
      <svg
        class="size-6 group-aria-expanded:hidden"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        class="hidden size-6 group-aria-expanded:block"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="border-t border-white/5 md:hidden" hidden>
    <nav class="px-4 pt-3 pb-5" aria-label="Menu">
      <ul class="space-y-1 text-base font-medium">
        {nav.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={href === currentPath ? 'page' : undefined}
              class:list={[
                'block rounded-xl px-4 py-3 transition hover:bg-white/5 hover:text-white',
                href === currentPath ? 'bg-white/5 text-white' : 'text-slate-300',
              ]}>
              {label}
            </a>
          </li>
        ))}
      </ul>
      <SocialLinks class="mt-4 border-t border-white/5 px-2 pt-4" />
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('#mobile-menu')!;

  const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  }

  toggle.addEventListener('click', () => setOpen(!isOpen()));
  // Section links (/#strava…) stay on the same page, so the menu has to close itself.
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (isOpen() && !header.contains(e.target as Node)) setOpen(false);
  });
  matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
