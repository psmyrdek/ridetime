---
import { LINK_STRAVA } from '../const/social-links';
import { strava } from '../utils/strava';
import { formatDate } from '../utils/youtube';

const { year, ytd, latestActivity } = strava;
const number = new Intl.NumberFormat('pl-PL', { maximumFractionDigits: 0 });

const stats = [
  { label: 'Dystans', value: ytd.distanceKm, unit: 'km' },
  { label: 'Przejazdy', value: ytd.rides, unit: '' },
  { label: 'Przewyższenie', value: ytd.elevationM, unit: 'm' },
  { label: 'Czas w siodle', value: ytd.movingTimeH, unit: 'h' },
].filter((stat): stat is typeof stat & { value: number } => stat.value !== null);

const columns: Record<number, string> = { 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4' };
---

<section id="strava" class="mx-auto max-w-7xl px-4 sm:px-6">
  <div class="relative overflow-hidden rounded-3xl bg-ridetime-surface p-6 ring-1 ring-white/10 sm:p-10">
    <div class="absolute -top-24 -right-24 size-72 rounded-full bg-strava/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="flex items-center gap-2 text-sm font-semibold text-strava">
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"></path>
          </svg>
          Strava
        </p>
        <h2 class="mt-2 font-main text-3xl text-white sm:text-4xl">{year} na liczniku</h2>
      </div>
      <a
        href={LINK_STRAVA}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-strava px-4 py-2 text-sm font-semibold text-white transition hover:bg-orange-500">
        Obserwuj na Stravie
      </a>
    </div>

    <dl
      class:list={[
        'relative mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-2',
        columns[stats.length],
      ]}>
      {stats.map(({ label, value, unit }) => (
        <div class="bg-ridetime-surface p-6 sm:p-8">
          <dt class="text-sm text-slate-400">{label}</dt>
          <dd class="mt-2 flex items-baseline gap-2">
            <span class="font-main text-4xl text-white tabular-nums sm:text-5xl">{number.format(value)}</span>
            {unit && <span class="text-lg text-slate-400">{unit}</span>}
          </dd>
        </div>
      ))}
    </dl>

    {latestActivity && (
      <a
        href={`https://www.strava.com/activities/${latestActivity.id}`}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 rounded-2xl bg-white/5 px-6 py-4 ring-1 ring-white/10 transition hover:bg-white/10">
        <div class="min-w-0">
          <p class="text-xs font-semibold tracking-wide text-strava uppercase">Ostatnia aktywność</p>
          <p class="mt-1 truncate font-semibold text-white">{latestActivity.name}</p>
        </div>
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm whitespace-nowrap text-slate-300 tabular-nums">
          <span>{number.format(latestActivity.distanceKm)} km</span>
          <span>{number.format(latestActivity.elevationM)} m ↑</span>
          <time datetime={latestActivity.startDate} class="text-slate-400">
            {formatDate(latestActivity.startDate)}
          </time>
          <span class="text-strava transition group-hover:translate-x-0.5" aria-hidden="true">
            →
          </span>
        </p>
      </a>
    )}
  </div>
</section>
