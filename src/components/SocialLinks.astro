---

<ul class:list={['flex items-center gap-1', className]}>
  {links.map(({ label, href, path }) => (
    <li>
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="grid size-10 place-items-center rounded-full text-slate-300 transition hover:bg-white/10 hover:text-ridetime-light">
        <span class="sr-only">{label}</span>
        <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d={path} fill-rule="evenodd" clip-rule="evenodd" />
        </svg>
      </a>
    </li>
  ))}
</ul>
