---
import LiteYouTube from './LiteYouTube.astro';
import { cleanTitle, formatDate, formatViews, type Video } from '../utils/youtube';

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;
---

<ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
  {videos.map((video) => (
    <li>
      <article>
        <LiteYouTube videoId={video.id} title={video.title} thumbnail={video.thumbnail} />
        <h3 class="mt-4 font-semibold leading-snug text-white text-pretty">
          <a
            href={`https://www.youtube.com/watch?v=${video.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="transition hover:text-ridetime-light">
            {cleanTitle(video.title)}
          </a>
        </h3>
        <p class="mt-1 text-sm text-slate-400">
          <time datetime={video.publishedAt}>{formatDate(video.publishedAt)}</time>
          <span aria-hidden="true"> · </span>
          {formatViews(video.views)}
        </p>
      </article>
    </li>
  ))}
</ul>
