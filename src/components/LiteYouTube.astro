---
// Renders a thumbnail with a play button and swaps in the real YouTube iframe only on click,
// so the page doesn't load a dozen players up front.
interface Props {
  videoId: string;
  title: string;
  thumbnail: string;
  eager?: boolean;
}

const { videoId, title, thumbnail, eager = false } = Astro.props;
const poster = eager ? `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg` : thumbnail;
---

<lite-youtube
  data-id={videoId}
  data-title={title}
  class="group relative block aspect-video overflow-hidden rounded-2xl bg-black">
  <button type="button" class="absolute inset-0 size-full cursor-pointer" aria-label={`Odtwórz: ${title}`}>
    <img
      src={poster}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="size-full object-cover transition duration-500 group-hover:scale-[1.03] group-hover:opacity-90"
    />
    <span class="absolute inset-0 bg-linear-to-t from-black/50 via-transparent to-transparent"></span>
    <span class="absolute top-1/2 left-1/2 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-ridetime-light text-ridetime-dark shadow-xl transition group-hover:scale-110 sm:size-20">
      <svg viewBox="0 0 24 24" class="ml-1 size-7 sm:size-8" fill="currentColor" aria-hidden="true">
        <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z"></path>
      </svg>
    </span>
  </button>
</lite-youtube>

<script>
  class LiteYouTube extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => this.play(), { once: true });
    }

    play() {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0`;
      iframe.title = this.dataset.title ?? 'YouTube video player';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 size-full';
      this.replaceChildren(iframe);
    }
  }

  customElements.define('lite-youtube', LiteYouTube);
</script>
