---
import LiteYouTube from './LiteYouTube.astro';
import { cleanTitle, formatDate, formatViews, type Video } from '../utils/youtube';
import { LINK_YT_SUBSCRIBE } from '../const/social-links';

interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<section id="najnowszy" class="relative isolate overflow-hidden">
  <div class="absolute inset-x-0 -top-40 -z-10 h-[36rem] bg-[radial-gradient(ellipse_at_top,--theme(--color-ridetime-navy/55%),transparent_65%)]"></div>
  <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 pt-10 pb-4 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:pt-16">
    <div class="lg:order-2 lg:col-span-8">
      <div class="rounded-3xl bg-white/5 p-1.5 shadow-2xl ring-1 shadow-black/40 ring-white/10">
        <LiteYouTube videoId={video.id} title={video.title} thumbnail={video.thumbnail} eager />
      </div>
    </div>
    <div class="lg:order-1 lg:col-span-4">
      <p class="inline-flex items-center gap-2 rounded-full bg-ridetime-light/10 px-3 py-1 text-xs font-semibold tracking-wide text-ridetime-light uppercase ring-1 ring-ridetime-light/20">
        <span class="size-1.5 animate-pulse rounded-full bg-ridetime-light"></span>
        Najnowszy film
      </p>
      <h1 class="mt-5 font-main text-3xl leading-tight text-white text-balance sm:text-4xl xl:text-5xl">
        {cleanTitle(video.title)}
      </h1>
      <p class="mt-3 text-sm text-slate-400">
        <time datetime={video.publishedAt}>{formatDate(video.publishedAt)}</time>
        <span aria-hidden="true"> · </span>
        {formatViews(video.views)}
      </p>
      {video.description && <p class="mt-5 line-clamp-4 leading-relaxed text-slate-300">{video.description}</p>}
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`https://www.youtube.com/watch?v=${video.id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-ridetime-light px-5 py-2.5 text-sm font-semibold text-ridetime-dark transition hover:bg-white">
          Oglądaj na YouTube
        </a>
        <a
          href={LINK_YT_SUBSCRIBE}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full px-5 py-2.5 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/5 hover:ring-white/40">
          Subskrybuj kanał
        </a>
      </div>
    </div>
  </div>
</section>
